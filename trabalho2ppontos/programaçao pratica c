#include <stdio.h>

int main() {

    int idades[10];
    int idade, autorizacao;
    int liberados = 0;
    int negados = 0;
    int maiorIdade = 0;
    int somaIdades = 0;
    float media;

    for(int i = 0; i < 10; i++) {

        printf("Digite a idade: ");
        scanf("%d", &idade);

        printf("Possui autorizacao? (1 = sim / 0 = nao): ");
        scanf("%d", &autorizacao);

        idades[i] = idade;

        if(idade >= 18 || autorizacao == 1) {
            printf("ENTRADA LIBERADA\n");
            liberados++;
        } else {
            printf("ENTRADA NEGADA\n");
            negados++;
        }

        somaIdades += idade;

        if(idade > maiorIdade) {
            maiorIdade = idade;
        }
    }

    media = somaIdades / 10.0;

    printf("\nLiberados: %d\n", liberados);
    printf("Negados: %d\n", negados);
    printf("Maior idade: %d\n", maiorIdade);
    printf("Media das idades: %.2f\n", media);

    return 0;
}